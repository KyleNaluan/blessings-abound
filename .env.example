# Copy this file to .env and fill in what you need.
# Every value can stay empty for local development, and empty values fall back to the defaults noted above each one.
# Never commit .env, because it holds secrets.

# Local Postgres from docker compose. Defaults: thrift, thrift, thrift, 5432.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Host port for the API container. Default: 8000.
API_PORT=

# API database connection. Default: the local compose Postgres at localhost:5432.
# Docker compose sets this for the api container itself.
# For the shared demo, use the Supabase connection string with the postgresql+psycopg:// scheme.
DATABASE_URL=

# Origins allowed to call the API, as a JSON list. Default: ["http://localhost:5173"].
CORS_ORIGINS=

# Photo storage. Supabase Storage is used when SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are both set,
# otherwise photos go to LOCAL_STORAGE_DIR. Defaults: storage, photos.
LOCAL_STORAGE_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Lets the API check each request's sign-in with Supabase Auth, using SUPABASE_URL above and the same public anon key as
# VITE_SUPABASE_ANON_KEY below. The service role key works too when this is empty. With neither, every item route returns 503.
SUPABASE_ANON_KEY=

# First manager, read only by `uv run python -m app.create_first_manager` in api/, see docs/database.md.
# It also uses DATABASE_URL, SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above.
# The password is only needed the first time, when the Auth user is created.
FIRST_MANAGER_USERNAME=
FIRST_MANAGER_EMAIL=
FIRST_MANAGER_PASSWORD=

# Vision and language model, any OpenAI-compatible chat-completions endpoint, for example https://api.openai.com/v1.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Fallback for the same kind of endpoint, used when the first provider fails twice or cannot be reached.
# For Gemini: https://generativelanguage.googleapis.com/v1beta/openai/ and gemini-3.5-flash, because gemini-2.5-flash is closed to new keys.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=

# SerpApi key for eBay price comps. The free plan allows 250 searches a month and 50 an hour.
SERPAPI_API_KEY=

# API address the web app calls. Default: http://localhost:8000.
VITE_API_URL=

# Supabase Auth for sign-in in the web app. Use the project URL and the public anon key only, never the service-role key,
# because every VITE_ value is built into the public JavaScript. Leave both empty and the sign-in page says it isn't set up.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
